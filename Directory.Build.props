<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <Version>0.1.1-dev1</Version>
    <PackageVersion>0.1.1-dev1</PackageVersion>
    <AssemblyVersion>0.1.1.0</AssemblyVersion>
    <FileVersion>0.1.1.0</FileVersion>
    <InformationalVersion>0.1.1-dev1</InformationalVersion>
    <AIKernelCorePackageVersion>0.1.1</AIKernelCorePackageVersion>
    <AIKernelProvidersPackageVersion>0.1.1</AIKernelProvidersPackageVersion>
    <AIKernelWasmRuntimePackageVersion>0.1.1</AIKernelWasmRuntimePackageVersion>
    <AIKernelWasmWebGpuComputeProviderPackageVersion>0.1.1</AIKernelWasmWebGpuComputeProviderPackageVersion>
    <AIKernelProvidersPackageId>AIKernel.Providers.Standard</AIKernelProvidersPackageId>
  </PropertyGroup>
</Project>
