<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <StablePackageVersion>0.1.3</StablePackageVersion>
    <LocalPackageVersionPrefix>0.1.3</LocalPackageVersionPrefix>
    <LocalPackageBuildNumber Condition="'$(LocalPackageBuildNumber)' == ''">0</LocalPackageBuildNumber>
    <UseLocalPackageVersion Condition="'$(UseLocalPackageVersion)' == ''">false</UseLocalPackageVersion>
    <Version Condition="'$(UseLocalPackageVersion)' == 'true'">$(LocalPackageVersionPrefix)-dev$(LocalPackageBuildNumber)</Version>
    <Version Condition="'$(UseLocalPackageVersion)' != 'true'">$(StablePackageVersion)</Version>
    <PackageVersion>$(Version)</PackageVersion>
    <AssemblyVersion>$(StablePackageVersion)</AssemblyVersion>
    <FileVersion>$(StablePackageVersion)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <AIKernelPackageVersion Condition="'$(UseLocalPackageVersion)' == 'true'">[$(LocalPackageVersionPrefix)-dev$(LocalPackageBuildNumber)]</AIKernelPackageVersion>
    <AIKernelPackageVersion Condition="'$(UseLocalPackageVersion)' != 'true'">[$(StablePackageVersion)]</AIKernelPackageVersion>
    <AIKernelCorePackageVersion Condition="'$(UseLocalPackageVersion)' == 'true'">$(LocalPackageVersionPrefix)-dev$(LocalPackageBuildNumber)</AIKernelCorePackageVersion>
    <AIKernelCorePackageVersion Condition="'$(UseLocalPackageVersion)' != 'true'">$(StablePackageVersion)</AIKernelCorePackageVersion>
    <AIKernelProvidersPackageVersion Condition="'$(UseLocalPackageVersion)' == 'true'">$(LocalPackageVersionPrefix)-dev$(LocalPackageBuildNumber)</AIKernelProvidersPackageVersion>
    <AIKernelProvidersPackageVersion Condition="'$(UseLocalPackageVersion)' != 'true'">$(StablePackageVersion)</AIKernelProvidersPackageVersion>
    <AIKernelWasmRuntimePackageVersion Condition="'$(UseLocalPackageVersion)' == 'true'">$(LocalPackageVersionPrefix)-dev$(LocalPackageBuildNumber)</AIKernelWasmRuntimePackageVersion>
    <AIKernelWasmRuntimePackageVersion Condition="'$(UseLocalPackageVersion)' != 'true'">$(StablePackageVersion)</AIKernelWasmRuntimePackageVersion>
    <AIKernelWasmWebGpuComputeProviderPackageVersion Condition="'$(UseLocalPackageVersion)' == 'true'">$(LocalPackageVersionPrefix)-dev$(LocalPackageBuildNumber)</AIKernelWasmWebGpuComputeProviderPackageVersion>
    <AIKernelWasmWebGpuComputeProviderPackageVersion Condition="'$(UseLocalPackageVersion)' != 'true'">$(StablePackageVersion)</AIKernelWasmWebGpuComputeProviderPackageVersion>
    <AIKernelProvidersPackageId>AIKernel.Providers.Standard</AIKernelProvidersPackageId>
  </PropertyGroup>
</Project>
