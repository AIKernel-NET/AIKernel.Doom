diff --git a/doomgeneric/Makefile b/doomgeneric/Makefile
new file mode 100644
index 0000000..aik0001
--- /dev/null
+++ b/doomgeneric/Makefile
@@
+# AIKernel.Doom does not patch upstream engine files in place.
+# Instead, build from AIKernel.Doom/src/DoomWasm.Native/Makefile.
+#
+# Integration summary:
+# - compile upstream ozkl/doomgeneric C sources
+# - exclude upstream doomgeneric/w_file.c
+# - add AIKernel memory-backed WAD implementation:
+#     AIKernel.Doom/src/DoomWasm.Native/src/aik_doom_wad_file.c
+# - add AIKernel platform implementation:
+#     AIKernel.Doom/src/DoomWasm.Native/src/doomgeneric_aikernel.c
+# - add AIKernel native sound bridge:
+#     AIKernel.Doom/src/DoomWasm.Native/src/aik_doom_sound.c
+# - compile with:
+#     -DDOOMGENERIC_RESX=320
+#     -DDOOMGENERIC_RESY=200
+#     -DCMAP256=1
+#     -sFILESYSTEM=0
+# - export:
+#     main, doom_init, doom_tick, doom_render, doom_input
+#
+# Most integration code lives outside upstream sources. Upstream source patches:
+# - m_misc.c: memory-backed DOOM1.WAD must satisfy the IWAD existence check
+#   before W_OpenFile() is reached.
+# - d_main.c: AIKernel drives ticks cooperatively, so startup tick and synchronous
+#   wipe loops are skipped for AIKERNEL_DOOM_WASM builds.
+# - i_sound.c: AIKernel WASM sound uses the overlay DG_sound_module and must not
+#   include SDL_mixer when FEATURE_SOUND is enabled.
diff --git a/doomgeneric/doomgeneric_aikernel.c b/doomgeneric/doomgeneric_aikernel.c
new file mode 100644
index 0000000..aik0002
--- /dev/null
+++ b/doomgeneric/doomgeneric_aikernel.c
@@
+/* See AIKernel.Doom/src/DoomWasm.Native/src/doomgeneric_aikernel.c */
diff --git a/doomgeneric/aik_doom_wad_file.c b/doomgeneric/aik_doom_wad_file.c
new file mode 100644
index 0000000..aik0003
--- /dev/null
+++ b/doomgeneric/aik_doom_wad_file.c
@@
+/* See AIKernel.Doom/src/DoomWasm.Native/src/aik_doom_wad_file.c */
diff --git a/doomgeneric/m_misc.c b/doomgeneric/m_misc.c
index upstream..aik0004 100644
--- a/doomgeneric/m_misc.c
+++ b/doomgeneric/m_misc.c
@@
 #include "w_wad.h"
 #include "z_zone.h"
+#include "aik_doom_wad.h"
@@
 boolean M_FileExists(char *filename)
 {
     FILE *fstream;
+
+    if (filename != NULL
+     && aik_doom_wad_status() == AIK_DOOM_OK
+     && (strcasecmp(filename, "doom1.wad") == 0
+      || strcasecmp(filename, "aikernel.wad") == 0))
+    {
+        return true;
+    }
 
     fstream = fopen(filename, "r");
diff --git a/doomgeneric/d_main.c b/doomgeneric/d_main.c
index upstream..aik0005 100644
--- a/doomgeneric/d_main.c
+++ b/doomgeneric/d_main.c
@@
     if (!wipe)
     {
 	I_FinishUpdate ();              // page flip or blit buffer
 	return;
     }
+
+#ifdef AIKERNEL_DOOM_WASM
+    // AIKernel drives frames cooperatively from JavaScript. The vanilla wipe
+    // path runs a synchronous loop until the transition completes, which can
+    // monopolize the WASM worker during menu -> episode -> skill transitions.
+    I_FinishUpdate ();
+    return;
+#endif
@@
-    TryRunTics();
+#ifndef AIKERNEL_DOOM_WASM
+    TryRunTics();
+#endif
@@
-    doomgeneric_Tick();
+#ifndef AIKERNEL_DOOM_WASM
+    doomgeneric_Tick();
+#endif
diff --git a/doomgeneric/i_sound.c b/doomgeneric/i_sound.c
index upstream..aik0006 100644
--- a/doomgeneric/i_sound.c
+++ b/doomgeneric/i_sound.c
@@
-#if defined(FEATURE_SOUND) && !defined(__DJGPP__)
+#if defined(FEATURE_SOUND) && !defined(__DJGPP__) && !defined(AIKERNEL_DOOM_WASM)
 #include <SDL_mixer.h>
 #endif
