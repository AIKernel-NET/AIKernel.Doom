<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Public Web runtime assets for the AIKernel.Doom WASM demo. Does not include WAD, model, or generated WASM binaries.</Description>
    <IsPackable>false</IsPackable>
    <IncludeBuildOutput>true</IncludeBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AIKernel.Wasm.WebGpuComputeProvider"
                      Version="[$(AIKernelWasmWebGpuComputeProviderPackageVersion)]"
                      GeneratePathProperty="true"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(PkgAIKernel_Wasm_WebGpuComputeProvider)' != ''">
    <Content Include="$(PkgAIKernel_Wasm_WebGpuComputeProvider)\runtime\browser\webgpu-envelope-bridge.js"
             Link="wwwroot\js\aikernel\webgpu-envelope-bridge.js"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(PkgAIKernel_Wasm_WebGpuComputeProvider)\runtime\browser\webgpu-envelope-bridge.js"
             Link="wwwroot\demo\doom\js\aikernel\webgpu-envelope-bridge.js"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(PkgAIKernel_Wasm_WebGpuComputeProvider)\shaders\hud\hud-composite.wgsl"
             Link="wwwroot\js\aikernel\shaders\hud-composite.wgsl"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(PkgAIKernel_Wasm_WebGpuComputeProvider)\shaders\hud\hud-composite.wgsl"
             Link="wwwroot\demo\doom\js\aikernel\shaders\hud-composite.wgsl"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(PkgAIKernel_Wasm_WebGpuComputeProvider)\shaders\aisthesis\aisthesis.wgsl"
             Link="wwwroot\js\aikernel\shaders\aisthesis.wgsl"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(PkgAIKernel_Wasm_WebGpuComputeProvider)\shaders\aisthesis\aisthesis.wgsl"
             Link="wwwroot\demo\doom\js\aikernel\shaders\aisthesis.wgsl"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(PkgAIKernel_Wasm_WebGpuComputeProvider)\shaders\spatial\spatial-reasoning.wgsl"
             Link="wwwroot\js\aikernel\shaders\spatial-reasoning.wgsl"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(PkgAIKernel_Wasm_WebGpuComputeProvider)\shaders\spatial\spatial-reasoning.wgsl"
             Link="wwwroot\demo\doom\js\aikernel\shaders\spatial-reasoning.wgsl"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="wwwroot\**\*"
             CopyToOutputDirectory="PreserveNewest" />
    <None Include="README.md" />
  </ItemGroup>
</Project>
