{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aikernel.net/schemas/doom/autoplay-action.schema.json",
  "title": "AIKernel Doom Autoplay Action",
  "type": "object",
  "required": ["move", "turn", "fire", "strafe", "use", "run"],
  "properties": {
    "move": { "enum": ["none", "forward", "back"] },
    "turn": { "enum": ["none", "left", "right"] },
    "fire": { "type": "boolean" },
    "strafe": { "type": "boolean" },
    "use": { "type": "boolean" },
    "run": { "type": "boolean" },
    "source": { "type": "string" },
    "pipeline": { "type": "string" },
    "objective": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
